# GitLab environment configuration
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# Public hostname and domain
BASE_HOST_NAME=gitlab.example.com
BASE_DOMAIN_NAME=example.com

# Root (admin) password — set on first run
APP_ADMIN_PASS=changeme_admin_password

# Email / SMTP
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=noreply@example.com
